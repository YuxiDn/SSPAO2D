{
  "output_dir": "outputs/rln2d_supervised",
  "model": {
    "name": "rln2d",
    "in_channels": 1,
    "out_channels": 1,
    "num_features": 8,
    "num_iterations": 1,
    "kernel_size": 3,
    "norm": "batch",
    "eps": 0.0001,
    "ratio_clip": 10.0,
    "residual": false,
    "final_activation": null
  },
  "data": {
    "normalization_mode": "input_scale",
    "input_scale_method": "percentile",
    "input_scale_percentile": 99.5,
    "patch_size": [512, 512],
    "train": {
      "manifest": "metadata/manifest.csv",
      "augment": true,
      "samples_per_epoch": 2000
    },
    "val": {
      "manifest": "validation/metadata/manifest.csv",
      "augment": false,
      "samples_per_epoch": 400
    },
    "test": {
      "manifest": "Test/metadata/manifest.csv",
      "augment": false
    }
  },
  "training": {
    "epochs": 100,
    "batch_size": 128,
    "num_workers": 4,
    "optimizer": "Adam",
    "initial_learning_rate": 0.001,
    "loss": "rln",
    "iterations_per_epoch": 100,
    "lr_scheduler": "exponential_step",
    "lr_scheduler_interval": "step",
    "min_lr": 1e-06,
    "weight_decay": 0.0,
    "decay_steps": 600,
    "gamma": 0.95
  }
}
